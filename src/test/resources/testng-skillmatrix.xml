<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="SkillMatrix Suite" parallel="classes" thread-count="3">

    <listeners>
        <listener class-name="wns.automation.utilities.TestResultListener"/>
    </listeners>

    <test name="SkillMatrixTest">
        <classes>
            <class name="testscripts.SkillMatrix.testMainCategory" />
            <class name="testscripts.SkillMatrix.testSubCategory" />
            <class name="testscripts.SkillMatrix.testSkills" />
        </classes>
    </test>

</suite>