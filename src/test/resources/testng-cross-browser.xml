<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Cross Browser Regression Suite">
    <listeners>
        <listener class-name="wns.automation.utilities.TestResultListener"/>
    </listeners>

    <test name="Chrome">
        <parameter name="browser" value="Chrome"/>
        <classes>
            <class name="testscripts.Playwright.OHRMLoginTestPW"/>
            <class name="testscripts.Playwright.SMLoginTestPW"/>
        </classes>
    </test>

    <test name="Edge">
        <parameter name="browser" value="Edge"/>
        <classes>
            <class name="testscripts.Playwright.OHRMLoginTestPW"/>
            <class name="testscripts.Playwright.SMLoginTestPW"/>
        </classes>
    </test>

    <test name="Firefox">
        <parameter name="browser" value="Firefox"/>
        <classes>
            <class name="testscripts.Playwright.OHRMLoginTestPW"/>
            <class name="testscripts.Playwright.SMLoginTestPW"/>
        </classes>
    </test>
</suite>
